{
  "name": "our-memories-assets",
  "main": "src/index.js",
  "compatibility_date": "2026-06-15",
  "workers_dev": true,
  "r2_buckets": [
    {
      "binding": "MEMORY_ASSETS",
      "bucket_name": "our-memories-assets"
    }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "http://127.0.0.1:5173,http://localhost:5173,https://zhangkai0609.github.io",
    "PUBLIC_BASE_URL": ""
  }
}
